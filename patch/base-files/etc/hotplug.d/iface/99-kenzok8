#!/bin/sh
# ============================================================
# kenzok8 源配置 - hotplug 网络接口触发脚本
# 
# 功能：监听 WAN 接口上线事件，网络就绪后自动触发源配置
# 触发时机：任意 WAN 类接口 ifup（上线）时
# 设计原则：
#   1. 不阻塞启动：立即返回，实际工作放后台执行
#   2. 幂等安全：已完成则直接跳过，不重复执行
#   3. 容错兜底：所有错误静默处理，绝不影响 hotplug 流程
#
# 位置：/etc/hotplug.d/iface/99-kenzok8
# 说明：99 开头确保在其他接口处理逻辑之后执行
# ============================================================

# -------------------------- 配置区 --------------------------
# 成功标记文件（持久化）
DONE_MARK="/etc/kenzok8.done"
# 主脚本路径
SETUP_SCRIPT="/usr/share/kenzok8/setup.sh"
# 延迟执行时间（秒）- 等路由和网络完全就绪
DELAY_SECONDS=15

# -------------------------- 主逻辑 --------------------------
# 第一步：幂等检查 - 已成功配置过则直接退出
# 快速检查，不做任何多余操作
if [ -f "$DONE_MARK" ]; then
    exit 0
fi

# 第二步：只处理接口上线（ifup）事件
# hotplug 环境变量 ACTION 表示事件类型
if [ "$ACTION" != "ifup" ]; then
    # 不是上线事件，直接退出
    exit 0
fi

# 第三步：只处理 WAN 类接口
# 常见 WAN 接口名：wan、wan6、pppoe-wan、eth1、wwan 等
# 用 case 匹配，兼容多种命名方式
case "$INTERFACE" in
    wan|wan6|pppoe-wan|wwan|eth1|usb0)
        # 匹配到 WAN 类接口，继续
        ;;
    *)
        # 不是 WAN 接口，直接退出
        exit 0
        ;;
esac

# 第四步：检查主脚本是否存在
if [ ! -f "$SETUP_SCRIPT" ]; then
    # 主脚本不存在，静默退出
    exit 0
fi

# 第五步：后台延迟执行主脚本
# 关键点：
#   1. 使用 ( ... ) & 放入子shell后台执行
#   2. sleep 延迟等待网络完全就绪
#   3. 所有输出重定向，不干扰控制台
#   4. 本脚本立即返回，不阻塞 hotplug 流程
(
    # 延迟执行，等路由表、DNS、防火墙都就绪
    sleep "$DELAY_SECONDS"

    # 二次确认标记（延迟期间可能已经被其他触发源完成了）
    if [ -f "$DONE_MARK" ]; then
        exit 0
    fi

    # 执行主脚本
    if [ -x "$SETUP_SCRIPT" ]; then
        "$SETUP_SCRIPT"
    else
        # 没有执行权限的兜底方案
        sh "$SETUP_SCRIPT"
    fi

    # 确保子shell也返回0
    exit 0
) &

# 第六步：立即返回，绝不阻塞 hotplug 流程
# hotplug 脚本阻塞会导致接口启动变慢，甚至超时
exit 0
