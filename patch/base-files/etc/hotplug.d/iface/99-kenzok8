#!/bin/sh
# ============================================================
# kenzok8 源配置 - hotplug 网络接口触发脚本
#
# 功能：监听 WAN 接口上线事件，网络就绪后自动触发源配置
# 触发时机：任意 WAN 类接口 ifup（上线）时
# 设计原则：
#   1. 不阻塞启动：立即返回，实际工作放后台执行
#   2. 幂等安全：已完成则直接跳过，不重复执行
#   3. 容错兜底：所有错误静默处理，绝不影响 hotplug 流程
#
# 位置：/etc/hotplug.d/iface/99-kenzok8
# 说明：99 开头确保在其他接口处理逻辑之后执行
# ============================================================

# -------------------------- 配置区 --------------------------
# 成功标记文件（持久化）
DONE_MARK="/etc/kenzok8.done"
# 主脚本路径
SETUP_SCRIPT="/usr/share/kenzok8/setup.sh"
# 延迟执行时间（秒）- 等路由和网络完全就绪
DELAY_SECONDS=15

# -------------------------- 主逻辑 --------------------------
# 第一步：幂等检查 - 已成功配置过则直接退出
# 快速检查，不做任何多余操作
if [ -f "$DONE_MARK" ]; then
    exit 0
fi

# 第二步：只处理接口上线（ifup）事件
# hotplug 环境变量 ACTION 表示事件类型
if [ "$ACTION" != "ifup" ]; then
    # 不是上线事件，直接退出
    exit 0
fi

# 第三步：只处理 WAN 类接口
# 匹配规则：
#   - 精确匹配常见 WAN 接口名
#   - 以 "wan" 开头的接口（wan、wan6、wan_eth、wan_pppoe 等）
#   - 常见物理/虚拟 WAN 接口
case "$INTERFACE" in
    wan|wan6|wan_6|wan_4|wan_eth|wan_ppp|wan_pppoe|wan_lte|wan_5g|\
    wan_bak|wan_mwan|wan_failover|\
    pppoe-wan|pppoe-wan6|pppoe-wan_6|pppoe-wan_4|\
    eth0|eth0.2|eth1|eth2|eth3|eth4|\
    vlan2|vlan3|vlan4|\
    wwan|wwan0|wwan1|wwan2|\
    usb0|usb1|usb2|usb3|\
    modem|modem_1|modem1|modem_2|modem2|\
    rmnet_mhi0|rmnet_data0|rmnet_data1|\
    qmimux0|qmi_0|\
    wan*)
        # 匹配到 WAN 类接口，继续
        ;;
    *)
        # 不是 WAN 接口，直接退出
        exit 0
        ;;
esac

# 第四步：检查主脚本是否存在
if [ ! -f "$SETUP_SCRIPT" ]; then
    # 主脚本不存在，静默退出
    exit 0
fi

# 第五步：后台延迟执行主脚本
# 关键点：
#   1. 使用 ( ... ) & 放入子shell后台执行
#   2. sleep 延迟等待网络完全就绪
#   3. 所有输出重定向，不干扰控制台
#   4. 本脚本立即返回，不阻塞 hotplug 流程
(
    # 延迟执行，等路由表、DNS、防火墙都就绪
    sleep "$DELAY_SECONDS"

    # 二次确认标记（延迟期间可能已经被其他触发源完成了）
    if [ -f "$DONE_MARK" ]; then
        exit 0
    fi

    # 执行主脚本
    if [ -x "$SETUP_SCRIPT" ]; then
        "$SETUP_SCRIPT"
    else
        # 没有执行权限的兜底方案
        sh "$SETUP_SCRIPT"
    fi

    # 确保子shell也返回0
    exit 0
) &

# 第六步：立即返回，绝不阻塞 hotplug 流程
# hotplug 脚本阻塞会导致接口启动变慢，甚至超时
exit 0
