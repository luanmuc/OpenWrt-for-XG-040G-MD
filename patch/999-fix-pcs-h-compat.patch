--- /dev/null
+++ b/include/linux/pcs/pcs.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Compatibility wrapper for linux/pcs/pcs.h
+ * In kernel 6.12+, PCS definitions have been integrated into linux/phylink.h
+ */
+#ifndef _LINUX_PCS_PCS_H_COMPAT
+#define _LINUX_PCS_PCS_H_COMPAT
+
+#include <linux/phylink.h>
+#include <linux/netdevice.h>
+
+/* Backward compatibility alias */
+#define pcs_get_state phylink_pcs_get_state
+
+/*
+ * netdev_from_priv - 6.12 kernel does not have this function
+ * Reverse of netdev_priv: get net_device pointer from private data pointer
+ */
+static inline struct net_device *netdev_from_priv(void *priv)
+{
+	return (struct net_device *)((char *)priv -
+		ALIGN(sizeof(struct net_device), NETDEV_ALIGN));
+}
+
+/* fwnode_phylink_pcs_parse - 6.12 kernel does not have this function
+ * Stub implementation: return not supported
+ */
+static inline int fwnode_phylink_pcs_parse(struct fwnode_handle *fwnode,
+					    struct phylink_pcs **pcs,
+					    unsigned int *num_pcs)
+{
+	return -ENOTSUPP;
+}
+
+#endif /* _LINUX_PCS_PCS_H_COMPAT */
